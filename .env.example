# --- Notion ---
# Notion Internal Integration Token (Settings > Integrations > Ops Assistant)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ops Meeting Log database ID (from the database URL)
NOTION_DATABASE_ID=b98992c5c09e465db3139eea6949db52
# Random string you choose yourself; Notion sends it back on webhook verification
NOTION_WEBHOOK_VERIFICATION_TOKEN=changeme

# --- Google / Gmail ---
GOOGLE_CLIENT_EMAIL=ops-assistant@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GMAIL_USER=s.kinugasa@hrts.co.jp
GMAIL_LABEL_NAME=OpsMeeting
# Pub/Sub topic that Gmail publishes new-message notifications to
GOOGLE_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-ops-meeting

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cheapest model that's accurate enough for this workload; upgrade to a Sonnet model if quality is insufficient
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Misc ---
# Shared secret Vercel Cron sends so /api/gmail/watch can't be called by randoms
CRON_SECRET=changeme
